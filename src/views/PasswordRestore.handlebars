<div class="page-header">
  <h1><i class="fas fa-key"></i> Restablece tu Contraseña</h1>
  <p class="subtitle">Ingresa tu nueva contraseña</p>
</div>

<div style="padding: 20px 20px 80px;">
  <form class="form-tech" id="restoreForm">
    <div class="mb-4">
      <label class="form-label"><i class="fas fa-lock"></i> Nueva Contraseña</label>
      <input type="password" name="newPassword" class="form-control" placeholder="••••••••" required />
    </div>

    <button type="submit" class="btn btn-primary-tech btn-lg w-100">
      <i class="fas fa-sync-alt"></i> Restablecer Contraseña
    </button>

    <div class="text-center mt-4" style="color: var(--text-secondary); font-size: 0.9rem;">
      <a href="/login" style="color: var(--accent-cyan);"><i class="fas fa-arrow-left"></i> Volver al inicio de sesión</a>
    </div>
  </form>
</div>

<script src="/js/PasswordRestore.js"></script>
