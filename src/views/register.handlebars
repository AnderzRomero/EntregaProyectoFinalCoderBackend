<div class="page-header">
  <h1><i class="fas fa-user-plus"></i> Crear Cuenta</h1>
  <p class="subtitle">Únete a la comunidad HeroSystems</p>
</div>

<div style="padding: 20px 20px 80px;">
  <form class="form-tech" id="registerForm">
    <div class="mb-3">
      <label class="form-label"><i class="fas fa-user"></i> Nombre</label>
      <input type="text" name="firstName" class="form-control" placeholder="Tu nombre" required />
    </div>
    <div class="mb-3">
      <label class="form-label"><i class="fas fa-user"></i> Apellido</label>
      <input type="text" name="lastName" class="form-control" placeholder="Tu apellido" required />
    </div>
    <div class="mb-3">
      <label class="form-label"><i class="fas fa-envelope"></i> Correo Electrónico</label>
      <input type="email" name="email" class="form-control" placeholder="tu@correo.com" required />
    </div>
    <div class="mb-3">
      <label class="form-label"><i class="fas fa-calendar"></i> Edad</label>
      <input type="number" name="age" class="form-control" placeholder="Tu edad" required />
    </div>
    <div class="mb-4">
      <label class="form-label"><i class="fas fa-lock"></i> Contraseña</label>
      <input type="password" name="password" class="form-control" placeholder="••••••••" required />
    </div>

    <button type="submit" class="btn btn-primary-tech btn-lg w-100 mb-3"><i class="fas fa-user-plus"></i> Crear Cuenta</button>

    <div class="divider-tech">O regístrate con</div>

    <div class="social-login">
      <a href="/api/sessions/github" class="social-btn"><i class="fab fa-github"></i> GitHub</a>
      <a href="/api/sessions/google" class="social-btn"><i class="fab fa-google"></i> Google</a>
    </div>

    <div class="text-center mt-4" style="color: var(--text-secondary); font-size: 0.9rem;">
      ¿Ya tienes cuenta? <a href="/login" style="color: var(--accent-cyan); font-weight: 600;">Inicia sesión</a>
    </div>
  </form>
</div>

<script src="/js/register.js"></script>
