<div style="padding: 80px 20px; text-align: center; max-width: 500px; margin: 0 auto;">
  <div style="font-size: 4rem; color: #dc2626; margin-bottom: 20px;">
    <i class="fas fa-exclamation-triangle"></i>
  </div>
  <h1 style="font-family: 'Orbitron', sans-serif; font-size: 1.5rem; color: var(--text-primary); margin-bottom: 16px;">Error</h1>
  <div class="alert-tech alert-danger" style="text-align: center;">
    <i class="fas fa-info-circle"></i> {{error}}
  </div>
  <a href="/password-restore?token={{token}}" class="btn btn-primary-tech mt-3"><i class="fas fa-redo"></i> Intentar de nuevo</a>
  <a href="/login" class="btn btn-ghost mt-3 ms-2"><i class="fas fa-arrow-left"></i> Volver al login</a>
</div>
