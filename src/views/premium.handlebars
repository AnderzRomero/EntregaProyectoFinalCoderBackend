<div class="page-header">
  <h1><i class="fas fa-crown"></i> Suscripción Premium</h1>
  <p class="subtitle">Ingresa los documentos requeridos para obtener tu membresía</p>
</div>

<div style="padding: 20px 20px 80px;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; max-width: 1000px; margin: 0 auto 40px;">
    <div class="contact-info-card">
      <div class="contact-icon"><i class="fas fa-crown" style="color: var(--accent-orange);"></i></div>
      <h4 style="color: var(--accent-orange);">Beneficios Premium</h4>
      <p style="text-align: left; font-size: 0.85rem; line-height: 2;">
        <i class="fas fa-check-circle" style="color: var(--accent-teal);"></i> Descuentos exclusivos<br>
        <i class="fas fa-check-circle" style="color: var(--accent-teal);"></i> Envío gratis prioritario<br>
        <i class="fas fa-check-circle" style="color: var(--accent-teal);"></i> Soporte técnico 24/7<br>
        <i class="fas fa-check-circle" style="color: var(--accent-teal);"></i> Acceso a preventas<br>
        <i class="fas fa-check-circle" style="color: var(--accent-teal);"></i> Garantía extendida
      </p>
    </div>
    <div class="contact-info-card">
      <div class="contact-icon"><i class="fas fa-file-alt" style="color: var(--accent-cyan);"></i></div>
      <h4 style="color: var(--accent-cyan);">Documentos Requeridos</h4>
      <p style="text-align: left; font-size: 0.85rem; line-height: 2;">
        <i class="fas fa-id-card" style="color: var(--accent-cyan);"></i> Foto de perfil<br>
        <i class="fas fa-id-card" style="color: var(--accent-cyan);"></i> DNI frontal y posterior<br>
        <i class="fas fa-home" style="color: var(--accent-cyan);"></i> Comprobante de domicilio<br>
        <i class="fas fa-university" style="color: var(--accent-cyan);"></i> Estado de cuenta bancario
      </p>
    </div>
  </div>

  <form class="form-tech" id="premiumForm" enctype="multipart/form-data" style="max-width: 600px;">
    <h3 style="font-family: 'Orbitron', sans-serif; font-size: 1.1rem; margin-bottom: 24px; color: var(--text-primary); text-align: center;">
      <i class="fas fa-upload" style="color: var(--accent-cyan);"></i> Sube tus documentos
    </h3>

    <div class="mb-3">
      <label class="form-label"><i class="fas fa-camera"></i> Foto de perfil</label>
      <input class="form-control" type="file" name="profile" id="profilePhoto" />
    </div>
    <div class="mb-3">
      <label class="form-label"><i class="fas fa-id-card"></i> DNI - Parte frontal</label>
      <input class="form-control" type="file" name="frontDni" id="frontDni" />
    </div>
    <div class="mb-3">
      <label class="form-label"><i class="fas fa-id-card"></i> DNI - Parte posterior</label>
      <input class="form-control" type="file" name="backDni" id="backDni" />
    </div>
    <div class="mb-3">
      <label class="form-label"><i class="fas fa-home"></i> Comprobante de domicilio</label>
      <input class="form-control" type="file" name="addressProof" id="addressProof" />
    </div>
    <div class="mb-3">
      <label class="form-label"><i class="fas fa-university"></i> Estado de cuenta bancario</label>
      <input class="form-control" type="file" name="bankStatement" id="bankStatement" />
    </div>

    <button class="btn btn-primary-tech btn-lg w-100 mt-3" type="submit" id="premiumSubmit">
      <i class="fas fa-crown"></i> Solicitar Membresía Premium
    </button>
  </form>
</div>

<script src="/js/premium.js"></script>
